# Copy to .env and fill in. Never commit .env.
# docker compose reads it automatically; all values below have working defaults except the API token.

# ENTSO-E Transparency Platform API token (request via your account on transparency.entsoe.eu).
# Required: ingest exits at startup without it.
ENTSOE_API_TOKEN=
# API endpoint; empty means the production endpoint https://web-api.tp.entsoe.eu/api
ENTSOE_BASE_URL=

# Postgres (source of truth, logical replication enabled)
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy
POSTGRES_DB=energy
POSTGRES_PORT=5432

# ClickHouse (analytical store, ADR 0024)
CLICKHOUSE_USER=energy
CLICKHOUSE_PASSWORD=energy
CLICKHOUSE_DB=energy
# DSN for `sink migrate` when run outside compose (compose builds its own from the values above)
CLICKHOUSE_DSN=clickhouse://energy:energy@localhost:9000/energy

# Sink (Kafka -> ClickHouse). Empty means the defaults: group energy-clickhouse-sink, both CDC topics,
# flush every 10000 records or 2s, whichever comes first.
SINK_GROUP_ID=
SINK_TOPICS=
SINK_BATCH_SIZE=
SINK_FLUSH_INTERVAL=
# For a sink run outside compose (go run ./cmd/sink)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085/apis/ccompat/v7
SINK_HTTP_ADDR=:8082

# Postgres DSN for ingest and `ingest migrate` when run outside compose (compose builds its own from the values above)
DATABASE_URL=postgres://energy:energy@localhost:5432/energy?sslmode=disable

# ingest service: listen address for /healthz, /readyz, /metrics when run outside compose (go run ./cmd/ingest)
INGEST_HTTP_ADDR=:8080
# Day-ahead price job (Go durations): how often to fetch, and the window around the current UTC
# midnight that every fetch covers, [midnight - LOOK_BACK, midnight + LOOK_AHEAD)
INGEST_DAY_AHEAD_INTERVAL=15m
INGEST_DAY_AHEAD_LOOK_BACK=24h
INGEST_DAY_AHEAD_LOOK_AHEAD=48h
# Bidding zones per dataset, comma-separated names from internal/entsoe/zones.go (e.g. NL,DE_LU,NO_2).
# Empty means every zone with data on the Transparency Platform (ADR 0029, 0030): 45 for prices,
# 46 for load, 47 for generation and weather.
# One job runs per zone and dataset; their first runs are spread over the interval.
INGEST_DAY_AHEAD_ZONES=
INGEST_ACTUAL_LOAD_ZONES=
INGEST_GENERATION_ZONES=
INGEST_WEATHER_ZONES=
# Actual load job, same semantics. The long look-back picks up TSO revisions of realised load.
INGEST_ACTUAL_LOAD_INTERVAL=15m
INGEST_ACTUAL_LOAD_LOOK_BACK=168h
INGEST_ACTUAL_LOAD_LOOK_AHEAD=24h
# Generation per production type (A75), same semantics; empty zone list means the 47 zones with data.
INGEST_GENERATION_INTERVAL=15m
INGEST_GENERATION_LOOK_BACK=168h
INGEST_GENERATION_LOOK_AHEAD=24h
# Weather from Open-Meteo (ADR 0031), points per zone in internal/openmeteo/points.go. Models update
# hourly; the window is 7 days of analysis back and 2 days of forecast ahead. No API key needed.
INGEST_WEATHER_INTERVAL=1h
INGEST_WEATHER_LOOK_BACK=168h
INGEST_WEATHER_LOOK_AHEAD=48h
# Empty means https://api.open-meteo.com/v1/forecast
OPEN_METEO_BASE_URL=

# Synthetic ENTSO-E API (make up-fake, ADR 0021): length of a revision epoch and the probability that a
# published slot younger than 7 days is revised in one epoch. Empty means 1h and 0.02.
FAKE_ENTSOE_REVISION_INTERVAL=
FAKE_ENTSOE_REVISION_RATE=

# Host ports
INGEST_PORT=8080
KAFKA_HOST_PORT=9092
CONNECT_PORT=8083
APICURIO_PORT=8085
SINK_PORT=8082
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
FAKE_ENTSOE_PORT=8081
